          {
            "enabled": true,
            "id": 121,
            "kind": "Script",
            "name": "RobotDriver",
            "pos": [
              0.0,
              0.0,
              0.0
            ],
            "rot": [
              0.0,
              0.0,
              0.0
            ],
            "size": [
              1.0,
              1.0,
              1.0
            ],
            "source": "-- A robot drives this Buggy round in circles using the seat's ThrottleFloat\n-- and SteerFloat. Sit in it yourself and your keys take over.\n-- Try changing the springs: Stiffness (strength), SpringTravel (how far the\n-- wheels move), Suspension (how much bounce is soaked up) and Grip (tyres).\nlocal seat = script.Parent:FindFirstChild(\"VehicleSeat\", true)\nseat.Stiffness = 0.8   -- a little softer than normal, so you can see it lean\nseat.Grip = 1\n\nwhile true do\n    if seat.Occupant == nil then\n        seat.ThrottleFloat = 0.6   -- a bit more than half gas\n        seat.SteerFloat = 0.6      -- turning right\n    end\n    wait(0.5)\nend\n"
          }
        ],
        "id": 105,
        "kind": "Model",
        "name": "RobotBuggy",
        "pos": [
          0.0,
          0.0,
          0.0
        ],
        "rot": [
          0.0,
          0.0,
          0.0
        ],
        "size": [
          1.0,
          1.0,
          1.0
        ]
      }
