// Cloudflare settings for Guts&Bolts: the website AND the Guts&Bolts server.
//   - website/ is served as it is (the front page and the web app).
//   - worker/index.js answers /api and /ws with the Guts&Bolts server, which
//     runs on Cloudflare (worker/server.js, a Durable Object with its own
//     database), so it's online even when your computer is off.
//
// Settings ("vars" below, or in the Cloudflare dashboard: Workers & Pages >
// project-guts-and-bolts > Settings > Variables and Secrets; those are kept
// when the site is redeployed, see keep_vars):
//   OFFICIAL     the staff account's ID (64 letters/numbers; in the Player: Staff
//                page > "Copy official ID"). That account becomes user #1,
//                "Guts", with the Staff and Verified badges. It's a public ID,
//                safe to keep here.
//   SERVER_NAME  the name the apps show for this server (default "Guts&Bolts").
//   GB_SERVER    only to use a server on a computer instead (host:port).
//   BREVO_API_KEY  (a Secret, not a variable) turns email on: password reset
//                codes, two-step login codes, support ticket answers. Get one free
//                at brevo.com (README: "Turning email on").
//   MAIL_FROM    the address emails come from (one Brevo knows, like
//                noreply@gutsandbolts.net). Needed with the key.
//   TURNSTILE_SITEKEY  turns on the "are you a person?" check for doubtful visitors
//                (worker/shield.js), with TURNSTILE_SECRET (a Secret). Both come from
//                the Cloudflare dashboard: Turnstile > Add widget (README: "DDoS and bot protection").
//   TURNSTILE_HOSTNAMES  optional: the sites the check may come from, split by commas
//                (default gutsandbolts.net).
{
  "name": "project-guts-and-bolts",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "keep_vars": true,
  // Before every deploy (and `wrangler dev`): gather the update log's files in
  // worker/updates/ and the built-in roadmap's in worker/roadmap/ into
  // worker/updates-gathered.js and worker/roadmap-gathered.js (see worker/gather-updates.mjs).
  "build": { "command": "node worker/gather-updates.mjs", "watch_dir": ["worker/updates", "worker/roadmap"] },
  // The example games (games/*.gbscene) are bundled into the server as text, so
  // they're always on it (see addExampleGames in worker/server.js).
  // The emotes and animation packs (assets/emotes/*.gbemotes) are bundled the same way.
  "rules": [{ "type": "Text", "globs": ["**/*.gbscene", "**/*.gbemotes"], "fallthrough": true }],
  "vars": { "OFFICIAL": "78587146c5027463ff988ef3dd4da3830482f59d6ac0e16fd29548c4a2c84c45" },
  "assets": {
    "directory": "./website",
    "binding": "ASSETS",
    // (The pages themselves too, so the old workers.dev address can send visitors to gutsandbolts.net.)
    "run_worker_first": ["/api", "/api/*", "/ws", "/thumb/*", "/icon/*", "/avatar/*", "/download/*", "/", "/index.html", "/app", "/app/", "/app/index.html",
      "/mcp", "/mcp/*", "/.well-known/oauth-protected-resource", "/.well-known/oauth-protected-resource/*", "/.well-known/oauth-authorization-server"]
  },
  "durable_objects": {
    "bindings": [{ "name": "GB_SERVER_OBJECT", "class_name": "GbServerObject" }]
  },
  // Cloudflare's translator for in-game chat (chat.translate in worker/server.js). Free up to a
  // daily amount; after that, lines just show as they were said until the next day.
  "ai": { "binding": "AI" },
  // The Player / Studio / Android downloads (worker/downloads.js).
  "r2_buckets": [{ "binding": "DOWNLOADS", "bucket_name": "gutsandbolts-downloads" }],
  // The risk check's speed limits (worker/shield.js), counted by Cloudflare per IP. "limit" is
  // how many a minute; keep SHIELD.limits in shield.js the same. namespace_id is just a number
  // that names each counter.
  "ratelimits": [
    { "name": "RATE_FLOOD",    "namespace_id": "4101", "simple": { "limit": 1200, "period": 60 } },
    { "name": "RATE_PICTURES", "namespace_id": "4102", "simple": { "limit": 3000, "period": 60 } },
    { "name": "RATE_BUSY",     "namespace_id": "4103", "simple": { "limit": 300,  "period": 60 } },
    { "name": "RATE_DOUBT",    "namespace_id": "4104", "simple": { "limit": 60,   "period": 60 } },
    { "name": "RATE_WS",       "namespace_id": "4105", "simple": { "limit": 30,   "period": 60 } }
  ],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GbServerObject"] }]
}
