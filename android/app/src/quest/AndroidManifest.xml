<?xml version="1.0" encoding="utf-8"?>
<!-- The Meta Quest version (the "quest" flavour in build.gradle): added on top of
     src/main/AndroidManifest.xml. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- A VR headset that knows where your head is. -->
    <uses-feature android:name="android.hardware.vr.headtracking" android:required="true" android:version="1" />

    <!-- OpenXR: the headset's VR software (found through the Khronos runtime broker). -->
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR" />
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM" />
    <queries>
        <provider android:authorities="org.khronos.openxr.runtime_broker;org.khronos.openxr.system_runtime_broker" />
        <intent>
            <action android:name="org.khronos.openxr.OpenXRRuntimeService" />
        </intent>
        <intent>
            <action android:name="org.khronos.openxr.OpenXRApiLayerService" />
        </intent>
    </queries>

    <application>
        <meta-data android:name="com.oculus.supportedDevices" android:value="quest2|questpro|quest3|quest3s" />
        <meta-data android:name="com.oculus.vr.focusaware" android:value="true" />
        <!-- Headsets don't turn: always "landscape" (the window the headset never shows). -->
        <activity
            android:name=".GutsActivity"
            android:screenOrientation="landscape"
            tools:replace="android:screenOrientation" />
    </application>
</manifest>
